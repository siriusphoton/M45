# Local development only. Compose reads these when copied to .env.
# Use an unused host port if another PostgreSQL instance is already running.
POSTGRES_DB=m45
POSTGRES_USER=m45
POSTGRES_PASSWORD=m45
POSTGRES_PORT=5432

# Keep the URL aligned with the PostgreSQL values above if you change them.
DATABASE_URL=postgresql+psycopg://m45:m45@127.0.0.1:5432/m45
LOG_LEVEL=INFO

# The Discord adapter calls the private Agent Server over loopback.
AGENT_SERVER_URL=http://127.0.0.1:2024
AGENT_SERVER_ASSISTANT_ID=m45

# Required only when running the Discord adapter.
DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USER_ID=123456789012345678

# Select "ollama" or "google_genai"; each provider keeps its own model name.
MODEL_PROVIDER=ollama
MODEL_NAME_GOOGLE=gemma-4-31b-it
MODEL_NAME_OLLAMA=gemma4:31b-cloud

# Provider credentials. Configure only the provider currently selected.
GOOGLE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Provisional recent-context window used during dogfooding.
PERSONAL_CONTEXT_MESSAGE_LIMIT=20
PERSONAL_CONTEXT_CHARACTER_LIMIT=12000

# Isolated ephemeral database used by integration tests.
POSTGRES_TEST_DB=m45_test
POSTGRES_TEST_PORT=5433
